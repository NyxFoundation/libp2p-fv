{
  "name": "libp2p-fv",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible finite-state checks for libp2p safety contracts",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=scripts/run-command.mjs --test-coverage-include=scripts/verification-results.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test tests/*.test.mjs",
    "verify": "node scripts/verify-session-safety.mjs"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.33.1"
  },
  "engines": {
    "node": ">=22"
  }
}
